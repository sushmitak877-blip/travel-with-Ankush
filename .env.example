# ═══════════════════════════════════════════════
#  Travel With Ankur — Environment Variables
#  Copy this file to .env and fill in your values
#  NEVER commit .env to GitHub!
# ═══════════════════════════════════════════════

# ── Twilio Credentials (from console.twilio.com) ──
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# ── Twilio WhatsApp Sender Number ──
# Sandbox: whatsapp:+14155238886
# Production (after approval): whatsapp:+your_twilio_number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── JWT Secret (use a long random string) ──
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_very_long_random_secret_string

# ── Server ──
PORT=3000
NODE_ENV=development
